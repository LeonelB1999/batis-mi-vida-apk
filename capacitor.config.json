{
  "appId": "com.batis.mivida",
  "appName": "Mi Vida",
  "webDir": "dist",
  "server": {
    "url": "http://129.159.90.187:8080/mivida/",
    "cleartext": true,
    "allowNavigation": [
      "129.159.90.187",
      "*.129.159.90.187"
    ],
    "androidScheme": "http"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "hardwareAcceleration": true
  },
  "ios": {
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#0f172a",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashImmersive": true
    },
    "StatusBar": {
      "overlaysWebView": true,
      "backgroundColor": "#00000000",
      "style": "LIGHT"
    }
  }
}
